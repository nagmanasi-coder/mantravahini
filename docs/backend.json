
{
  "entities": {
    "Mantra": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Mantra",
      "type": "object",
      "description": "Represents a specific mantra track available for playback.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "language": { "type": "string" },
        "durationSeconds": { "type": "number" },
        "assetId": { "type": "string" }
      },
      "required": ["id", "title", "description", "assetId"]
    },
    "Asset": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Asset",
      "type": "object",
      "description": "Metadata for digital files (audio, video, PDF, image).",
      "properties": {
        "id": { "type": "string" },
        "fileName": { "type": "string" },
        "fileType": { "type": "string", "enum": ["audio", "video", "document", "image"] },
        "mimeType": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "sizeBytes": { "type": "number" },
        "uploadDate": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fileName", "fileType", "mimeType", "url", "sizeBytes", "uploadDate"]
    },
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Stores user-specific data, settings, and subscription status.",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "subscriptionTier": { "type": "string", "enum": ["free", "basic", "premium"] },
        "premiumCycleStartDate": { "type": ["string", "null"], "format": "date-time" },
        "referralCode": { "type": "string" },
        "referredBy": { "type": "string" },
        "dailyAiMessages": { "type": "number", "description": "Count of AI messages sent today." },
        "lastAiMessageDate": { "type": "string", "format": "date-time", "description": "Date of last AI interaction." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": { "$ref": "#/backend/entities/UserProfile" },
          "description": "Private user profiles. Access restricted to the owner and administrators.",
          "params": [{ "name": "userId", "description": "The Firebase Auth UID of the user." }]
        }
      },
      {
        "path": "/mantras/{mantraId}",
        "definition": {
          "entityName": "Mantra",
          "schema": { "$ref": "#/backend/entities/Mantra" },
          "description": "Public mantra tracks. Read by all; Admin write.",
          "params": [{ "name": "mantraId", "description": "Unique identifier." }]
        }
      },
      {
        "path": "/assets/{assetId}",
        "definition": {
          "entityName": "Asset",
          "schema": { "$ref": "#/backend/entities/Asset" },
          "description": "Public media metadata. Read by all; Admin write.",
          "params": [{ "name": "assetId", "description": "Unique identifier." }]
        }
      },
      {
        "path": "/admin_users/{userId}",
        "definition": {
          "entityName": "AdminUser",
          "description": "Marker collection for admin roles. Presence grants privileges.",
          "params": [{ "name": "userId", "description": "Admin UID." }]
        }
      }
    ],
    "reasoning": "Standard structure for a content-driven app with premium features. Public content is separated from private user profiles to ensure security rules are simple and maintainable. DBAC markers are used for roles to avoid custom claims complexity."
  }
}
