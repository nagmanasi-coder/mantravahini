
{
  "entities": {
    "Mantra": {
      "title": "Mantra",
      "type": "object",
      "description": "Represents a specific mantra track available for playback.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "language": { "type": "string" },
        "durationSeconds": { "type": "number" },
        "assetId": { "type": "string" }
      },
      "required": ["id", "title", "description", "assetId"]
    },
    "Asset": {
      "title": "Asset",
      "type": "object",
      "description": "Metadata for digital files (audio, video, PDF, image).",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "fileName": { "type": "string" },
        "fileType": { "type": "string", "enum": ["audio", "video", "document", "image"] },
        "mimeType": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "sizeBytes": { "type": "number" },
        "uploadDate": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fileName", "fileType", "mimeType", "url", "sizeBytes", "uploadDate"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Stores user-specific data, settings, and subscription status.",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "subscriptionTier": { "type": "string", "enum": ["free", "premium"] },
        "isPranaPractitioner": { "type": "boolean" },
        "practitionerLevel": { "type": "number", "description": "1, 2, or 3 based on group growth." },
        "premiumCycleStartDate": { "type": ["string", "null"], "format": "date-time" },
        "referralCode": { "type": "string" },
        "referredBy": { "type": "string" },
        "streakCount": { "type": "number" },
        "lastStreakUpdate": { "type": "string", "format": "date-time" },
        "referralRewardClaimed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "DailyHoroscope": {
      "title": "DailyHoroscope",
      "type": "object",
      "description": "Daily AI-generated predictions for 12 Rashi and 12 Lagna.",
      "properties": {
        "date": { "type": "string", "description": "Format: YYYY-MM-DD" },
        "rashiData": { 
          "type": "object",
          "description": "Keyed by sign index (0-11)"
        },
        "lagnaData": {
          "type": "object",
          "description": "Keyed by sign index (0-11)"
        },
        "generatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "rashiData", "lagnaData"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "type": "object",
      "description": "Practitioner submitted results and testimonials. Approval process removed.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "content": { "type": "string" },
        "videoUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["approved"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "content", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "Private user profiles."
    },
    "/mantras/{mantraId}": {
      "schema": { "$ref": "#/backend/entities/Mantra" },
      "description": "Public mantra tracks."
    },
    "/daily_horoscope/{dateId}": {
      "schema": { "$ref": "#/backend/entities/DailyHoroscope" },
      "description": "Public daily predictions cached to save costs."
    },
    "/assets/{assetId}": {
      "schema": { "$ref": "#/backend/entities/Asset" },
      "description": "Public media metadata."
    },
    "/testimonials/{id}": {
      "schema": { "$ref": "#/backend/entities/Testimonial" },
      "description": "Practitioner healing results. No approval required."
    }
  }
}
