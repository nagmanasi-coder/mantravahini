
{
  "entities": {
    "Mantra": {
      "title": "Mantra",
      "type": "object",
      "description": "Represents a specific mantra track available for playback.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "language": { "type": "string" },
        "durationSeconds": { "type": "number" },
        "assetId": { "type": "string" }
      },
      "required": ["id", "title", "description", "assetId"]
    },
    "Asset": {
      "title": "Asset",
      "type": "object",
      "description": "Metadata for digital files (audio, video, PDF, image).",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "fileName": { "type": "string" },
        "fileType": { "type": "string", "enum": ["audio", "video", "document", "image"] },
        "mimeType": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "sizeBytes": { "type": "number" },
        "uploadDate": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fileName", "fileType", "mimeType", "url", "sizeBytes", "uploadDate"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Stores user-specific data, settings, and subscription status.",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "subscriptionTier": { "type": "string", "enum": ["free", "premium"] },
        "isPranaPractitioner": { "type": "boolean", "description": "Whether the user is a certified Prana Vidya practitioner." },
        "premiumCycleStartDate": { "type": ["string", "null"], "format": "date-time" },
        "referralCode": { "type": "string" },
        "referredBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "AdImpression": {
      "title": "AdImpression",
      "type": "object",
      "description": "Logs when a user watches an ad to unlock content.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "mantraId": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["rewarded_unlock", "interstitial", "banner"] }
      },
      "required": ["userId", "mantraId", "timestamp"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "Private user profiles."
    },
    "/mantras/{mantraId}": {
      "schema": { "$ref": "#/backend/entities/Mantra" },
      "description": "Public mantra tracks."
    },
    "/assets/{assetId}": {
      "schema": { "$ref": "#/backend/entities/Asset" },
      "description": "Public media metadata."
    },
    "/ad_impressions/{impressionId}": {
      "schema": { "$ref": "#/backend/entities/AdImpression" },
      "description": "Logs for revenue analysis."
    }
  }
}
