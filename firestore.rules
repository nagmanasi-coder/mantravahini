/**
 * FIRESTORE SECURITY RULES
 * 
 * Core Philosophy:
 * This ruleset implements a public-read, admin-write model for content (mantras/assets)
 * and a private-read/write model for user data.
 * 
 * Key Security Decisions:
 * 1. Developer Override: The hardcoded developer UID has full administrative access.
 * 2. Database-Backed Access Control (DBAC): Roles are determined by existence in admin_users.
 * 3. User Privacy: Users can read and write their own profile data in the 'users' collection.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the primary developer.
     * Update this UID when promoting a new account.
     */
    function isDeveloper() {
      return isSignedIn() && request.auth.uid == 'LPBTRz3AMafKtZVgzJWm5Aisxc53';
    }

    /**
     * @description Checks if the user is an admin via DBAC or Developer status.
     */
    function isAdmin() {
      return isDeveloper() || (isSignedIn() && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)));
    }

    function isExistingAdmin() {
      return isAdmin() && resource != null;
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for the 'users' collection.
     * Users manage their own profiles. Admins can manage all.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    /**
     * @description Rules for 'mantras'. Public read; Admin write.
     */
    match /mantras/{mantraId} {
      allow get, list: if true;
      allow create: if isAdmin() && request.resource.data.id == mantraId;
      allow update: if isExistingAdmin() && request.resource.data.id == resource.data.id;
      allow delete: if isExistingAdmin();
    }

    /**
     * @description Rules for 'assets'. Public metadata discovery; Admin management.
     */
    match /assets/{assetId} {
      allow get, list: if true;
      allow create: if isAdmin() && request.resource.data.id == assetId;
      allow update: if isExistingAdmin() && request.resource.data.id == resource.data.id;
      allow delete: if isExistingAdmin();
    }

    /**
     * @description Rules for 'admin_users'. Role management.
     */
    match /admin_users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isExistingAdmin();
      allow delete: if isExistingAdmin();
    }
  }
}