/**
 * Core Philosophy:
 * This ruleset establishes a secure, read-only data model for the Mantravaahini
 * app. The primary goal is to serve pre-loaded, static content (mantra tracks)
 * to all users, including those who are not signed in. The security posture is
 * to allow universal read access while completely prohibiting any client-side
 * write operations (create, update, delete) to protect the integrity of the
 * curated content.
 *
 * Data Structure:
 * The data is organized in a single, flat top-level collection:
 * - /mantra_tracks: Stores all mantra track documents.
 *
 * This simple structure is highly performant for the app's core function, which
 * is fetching and listing all available tracks.
 *
 * Key Security Decisions:
 * - Public Read Access: All mantra tracks are publicly readable. Any user,
 *   authenticated or anonymous, can fetch a single track or list all tracks.
 * - No Client Writes: To protect the pre-loaded content, all write operations
 *   from client applications are explicitly denied. Data is expected to be
 *   managed out-of-band by administrators (e.g., via the Firebase Console or
 *   the Admin SDK).
 * - No User Data: There are no user-specific collections or documents, simplifying
 *   the rules and eliminating the need for user-based ownership checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read-only access to all mantra tracks. All write operations are denied.
     * @path        /mantra_tracks/{trackId}
     * @allow       Any user, authenticated or not, retrieving a track document: `(get) /mantra_tracks/some_track_id`
     * @deny        Any user attempting to create a new track: `(create) /mantra_tracks/new_track with { ... }`
     * @principle   Secures pre-loaded, static content by making it publicly readable but non-modifiable by clients.
     */
    match /mantra_tracks/{trackId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // =====================================================================
    // Helper Functions
    // =====================================================================

    /**
     * isSignedIn
     * Checks if the user making the request is authenticated.
     */
    // function isSignedIn() {
    //   return request.auth != null;
    // }
  }
}