
/**
 * Core Philosophy:
 * This ruleset establishes a secure data model for the Mantravaahini app. It serves
 * public content (mantras) while protecting user-specific data.
 *
 * Data Structure:
 * The data is organized into two main collections:
 * - /mantra_tracks: Stores all mantra track documents, which are public.
 * - /users: Stores user profile information, including subscription tier, which is protected.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read-only access to all mantra tracks. All write operations are denied.
     * @path        /mantra_tracks/{trackId}
     * @principle   Secures pre-loaded, static content by making it publicly readable but non-modifiable by clients.
     */
    match /mantra_tracks/{trackId} {
      allow get, list: if true;
      allow write: if false;
    }

    /**
     * @description Defines access control for user profiles.
     * @path        /users/{userId}
     * @principle   Users own their data, but an admin role is required for privileged operations.
     */
    match /users/{userId} {
      // The admin can read any document and list all documents.
      // A regular user can only read their own document.
      allow read, list: if isDeveloper();
      allow read: if isOwner(userId);

      // A user can create their own profile, but must start with the 'free' tier.
      allow create: if isOwner(userId) && request.resource.data.subscriptionTier == 'free';
      
      // A user can update their profile, but cannot change their own subscription tier.
      allow update: if isOwner(userId) && request.resource.data.subscriptionTier == resource.data.subscriptionTier;

      // The developer has full write access for administrative tasks (e.g., granting subscriptions).
      allow write: if isDeveloper();
    }

    /**
     * @description Manages referral code mappings for the referral system.
     * @path        /referralCodes/{code}
     * @principle   Enables referral tracking by allowing users to create their own code mapping and letting any authenticated user look up a referrer.
     */
    match /referralCodes/{code} {
      // Allow any authenticated user to look up a referrer's UID from a code.
      allow get: if request.auth != null;
      
      // Allow a user to create their own referral code mapping.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Disallow modification or deletion of referral codes to ensure integrity.
      allow update, delete: if false;
    }

    // =====================================================================
    // Helper Functions
    // =====================================================================

    /**
     * Checks if the requesting user is the owner of the document.
     */
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    /**
     * Checks if the requesting user is the designated developer/admin.
     */
    function isDeveloper() {
      return request.auth != null && request.auth.uid == 'LPBTRz3AMafKtZVgzJWm5Aisxc53';
    }
  }
}
