
/**
 * FIRESTORE SECURITY RULES
 * Updated: 2024-06-01 (Fixed Testimonial list permission and restricted Kalajnana)
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    // Direct check for the developer UID
    function isDeveloper() {
      return isSignedIn() && request.auth.uid == 'LPBTRz3AMafKtZVgzJWm5Aisxc53';
    }

    // Admins are either the developer or listed in the admin_users collection
    function isAdmin() {
      return isDeveloper() || (isSignedIn() && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)));
    }

    function isPractitioner() {
      // Safely check if user document exists and has the practitioner flag
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && exists(userPath) && get(userPath).data.isPranaPractitioner == true;
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /mantras/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /assets/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Simplified match for testimonials to ensure broad 'list' query compatibility
    match /testimonials/{testimonialId} {
      // Allows all signed-in users to read testimonials
      // Application logic handles filtering for 'approved' status on public pages
      allow read: if isSignedIn();
      
      // Strict write access
      allow create: if isPractitioner() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /admin_users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && resource != null;
    }

    match /ad_impressions/{id} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    match /daily_horoscope/{dateId} {
      // Restrict access to registered users only as requested
      allow read: if isSignedIn();
      // Allow creation by registered users (first user of the day triggers AI)
      allow write: if isSignedIn();
    }
  }
}
