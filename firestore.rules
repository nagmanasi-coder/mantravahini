/**
 * Core Philosophy:
 * This ruleset establishes a secure model for the application's data.
 * The primary goal is to serve a curated, public collection of mantra tracks to all
 * users, while ensuring that user-specific data is private and can only be
 * modified by the owner.
 *
 * Data Structure:
 * - /mantras: Stores public metadata for each mantra track.
 * - /users: Stores private user profile information.
 *
 * Key Security Decisions:
 * - Public Read Access for Mantras: All documents in the /mantras collection are publicly
 *   readable by any client, authenticated or not.
 * - No Client-Side Writes to Mantras: All write operations from the client are disabled
 *   for the /mantras collection to protect the integrity of the curated content.
 * - User-Owned Profiles: Users can create, read, and update their own document in the
 *   /users collection. They cannot access or modify anyone else's data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description
     * Rules for the 'mantras' collection, which stores publicly accessible mantra tracks.
     * All users, including anonymous ones, can read this data, but no one can write
     * to it from the client, ensuring the integrity of this curated collection.
     * @path
     * /mantras/{mantraId}
     */
    match /mantras/{mantraId} {
      allow get, list: if true;
      allow write: if false;
    }

    /**
     * @description
     * Rules for the 'users' collection. Each user has their own document, identified
     * by their UID. Users can create their own profile and can read or update it.
     * They cannot read or write to any other user's profile.
     * @path
     * /users/{userId}
     */
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }
  }
}