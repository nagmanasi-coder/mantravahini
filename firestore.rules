
/**
 * FIRESTORE SECURITY RULES
 * 
 * Core Philosophy:
 * This ruleset implements a public-read, admin-write model for content (mantras/assets/courses)
 * and a private-read/write model for user data.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the primary developer.
     */
    function isDeveloper() {
      return isSignedIn() && request.auth.uid == 'LPBTRz3AMafKtZVgzJWm5Aisxc53';
    }

    /**
     * @description Checks if the user is an admin via DBAC or Developer status.
     */
    function isAdmin() {
      return isDeveloper() || (isSignedIn() && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)));
    }

    function isExistingAdmin() {
      return isAdmin() && resource != null;
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for the 'users' collection.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    /**
     * @description Public Content: mantras, assets, courses, modules, lessons.
     * These are publicly readable to all users, but only writable by admins.
     */
    match /mantras/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /assets/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /courses/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /modules/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /lessons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Rules for 'admin_users'. Role management.
     */
    match /admin_users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isExistingAdmin();
      allow delete: if isExistingAdmin();
    }
  }
}
