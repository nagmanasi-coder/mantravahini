
/**
 * FIRESTORE SECURITY RULES
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isDeveloper() {
      return isSignedIn() && request.auth.uid == 'LPBTRz3AMafKtZVgzJWm5Aisxc53';
    }

    function isAdmin() {
      return isDeveloper() || (isSignedIn() && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)));
    }

    function isPractitioner() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isPranaPractitioner == true;
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /mantras/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /assets/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{id} {
      // Admins can see and list all testimonials regardless of status
      allow list, get: if isSignedIn() && isAdmin();
      
      // Regular users can only list and see approved results
      // Note: Regular users must include the 'status == approved' filter in their queries
      allow list, get: if isSignedIn() && resource.data.status == 'approved';
      
      // Only practitioners can create
      allow create: if isPractitioner();
      
      // Only admins can modify or delete
      allow update, delete: if isAdmin();
    }

    match /admin_users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && resource != null;
    }

    match /ad_impressions/{id} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    match /daily_horoscope/{dateId} {
      // Kalajnana is public information available to all users to drive engagement
      allow read: if true;
      // Only signed-in users can trigger the daily AI generation to prevent spam/abuse
      allow write: if isSignedIn();
    }
  }
}
