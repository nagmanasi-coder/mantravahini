// --- FIREBASE STORAGE SECURITY RULES ---
// Updated: 2024-05-21 15:30 (Updated for cross-origin PDF viewing)
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isDeveloper() {
      return request.auth != null && request.auth.uid == 'LPBTRz3AMafKtZVgzJWm5Aisxc53';
    }

    match /assets/{allPaths=**} {
      // Public read access is necessary for embedded viewers and audio players
      allow read: if true;
      
      // Write access restricted to the developer
      allow write, create, delete: if isDeveloper();
    }
  }
}
