// --- FIREBASE STORAGE SECURITY RULES ---
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if the user is the primary developer
    function isDeveloper() {
      return isSignedIn() && request.auth.uid == 'LPBTRz3AMafKtZVgzJWm5Aisxc53';
    }

    // Rules for the assets folder
    match /assets/{allPaths=**} {
      // Allow public read access so mantras/videos can be played
      allow read: if true;
      
      // Only the developer (admin) can upload or delete files
      allow write: if isDeveloper();
    }
  }
}