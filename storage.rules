// --- FIREBASE STORAGE SECURITY RULES ---
// Updated: 2024-05-20
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if the user is the primary developer
    function isDeveloper() {
      return request.auth != null && request.auth.uid == 'LPBTRz3AMafKtZVgzJWm5Aisxc53';
    }

    // Rules for the assets folder
    match /assets/{allPaths=**} {
      // Allow public read access so premium content can be consumed
      allow read: if true;
      
      // Only the developer can upload or delete files
      allow write: if isDeveloper();
    }
  }
}